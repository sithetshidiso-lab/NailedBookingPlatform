{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Multi-tenant salon business profile in Qflow",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerUid": { "type": "string", "description": "Authenticated UID of the business owner" },
        "slug": { "type": "string", "description": "Unique URL-friendly slug" },
        "logoUrl": { "type": "string" },
        "templateId": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["businessName", "ownerEmail", "ownerUid", "slug", "plan", "isActive"]
    },
    "Service": {
      "title": "Service",
      "description": "A nail or beauty service offered by the business",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "number", "description": "Duration in minutes" }
      },
      "required": ["name", "category", "price"]
    },
    "Booking": {
      "title": "Booking",
      "description": "An appointment booking",
      "type": "object",
      "properties": {
        "serviceIds": { "type": "array", "items": { "type": "string" } },
        "serviceNames": { "type": "array", "items": { "type": "string" } },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "depositPaid": { "type": "boolean" },
        "totalPrice": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "referenceNumber": { "type": "string" },
        "proofOfPaymentSubmitted": { "type": "boolean" }
      },
      "required": ["serviceNames", "clientName", "clientEmail", "date", "time", "status", "referenceNumber"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "A customized discount/promotional offer by the studio",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discountValue": { "type": "string" },
        "promoCode": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "active"]
    },
    "Client": {
      "title": "Client",
      "description": "A client of the salon/platform",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "lastBooking": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "SuperAdmin": {
      "title": "SuperAdmin",
      "description": "A super administrator with global system-wide privileges",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["superadmin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A business expense",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" }
      },
      "required": ["title", "amount", "date"]
    },
    "GalleryImage": {
      "title": "GalleryImage",
      "description": "An image in the inspiration gallery",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "Base64 or URL of the image" },
        "name": { "type": "string", "description": "Name/design of the nail art" },
        "price": { "type": "number", "description": "Price of the design option" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "bookingPolicy": { "type": "string" },
        "cancellationPolicy": { "type": "string" },
        "galleryImages": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Information about a specific salon tenant"
    },
    "/tenants/{tenantId}/services/{serviceId}": {
      "schema": "Service",
      "description": "Collection of available services for a tenant"
    },
    "/tenants/{tenantId}/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of appointments for a tenant"
    },
    "/tenants/{tenantId}/clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of client records for a tenant"
    },
    "/tenants/{tenantId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of business expenses for a tenant"
    },
    "/tenants/{tenantId}/gallery/{imageId}": {
      "schema": "GalleryImage",
      "description": "Collection of gallery images for a tenant"
    },
    "/tenants/{tenantId}/promotions/{promoId}": {
      "schema": "Promotion",
      "description": "Collection of studio promotions shown to clients of a tenant"
    },
    "/tenants/{tenantId}/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "Tenant specific application settings"
    },
    "/tenants/{tenantId}/availability/{slotId}": {
      "schema": "object",
      "description": "Tenant specific slot availability"
    },
    "/tenants/{tenantId}/users/{userId}": {
      "schema": "object",
      "description": "Tenant specific user profiles and roles mapping matching active personnel"
    },
    "/superadmin/{email}": {
      "schema": "SuperAdmin",
      "description": "Collection of super administrator list keyed by email address"
    }
  }
}
